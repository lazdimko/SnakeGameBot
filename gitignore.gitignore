# Виртуальное окружение (папки с библиотеками, которые ты скачал локально)
venv/
.venv/
ENV/

# Секретные данные (токены, пароли, если ты хранишь их в отдельном файле)
.env

# Служебные папки Python (кэш)
__pycache__/
*.py[cod]
*$py.class

# Локальные базы данных (если бот сохраняет данные в файл .db или .sqlite)
*.db
*.sqlite3

# Настройки твоего редактора кода (например, VS Code)
.vscode/
.idea/